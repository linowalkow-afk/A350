            </p>

        </div>


        <div class="feature">

            <div class="feature-icon">◉</div>

            <h3>Effizienz</h3>

            <p>
                Moderne Aerodynamik und Triebwerke reduzieren
                Treibstoffverbrauch und Emissionen gegenüber
                früheren Generationen.
            </p>

        </div>


        <div class="feature">

            <div class="feature-icon">✦</div>

            <h3>Airspace Cabin</h3>

            <p>
                Eine moderne Kabine mit großen Gepäckfächern,
                Ambientebeleuchtung, fortschrittlicher Luftaufbereitung
                und hohem Komfort auf Langstrecken.
            </p>

        </div>

    </div>

</section>


<!-- GALLERY -->

<section id="gallery" class="reveal">

    <div class="section-label">05 / VISUAL ARCHIVE</div>

    <h2 class="section-title">
        A350 // VISUALS
    </h2>

    <div class="gallery">

        <div class="gallery-item gallery-main"></div>

        <div class="gallery-item gallery-cockpit"></div>

        <div class="gallery-item gallery-airbus"></div>

    </div>

</section>


<!-- FOOTER -->

<footer>

    <div>
        <div class="footer-title">A350//INFO</div>

        <p>
            Fan-made Informationsseite über die Airbus A350 Familie.
        </p>
    </div>

    <div>
        <p>
            * Reichweite abhängig von Variante und Konfiguration.<br>
            ** Maximale Sitzplatzkapazität abhängig von Variante.
        </p>
    </div>

</footer>


<script>

/* Scroll reveal */

const elements = document.querySelectorAll(".reveal");

const observer = new IntersectionObserver(
    entries => {

        entries.forEach(entry => {

            if (entry.isIntersecting) {
                entry.target.classList.add("visible");
            }

        });

    },
    {
        threshold: 0.12
    }
);

elements.forEach(element => observer.observe(element));


/* Subtle parallax effect */

window.addEventListener("scroll", () => {

    const hero = document.querySelector(".hero-image");

    if (hero) {
        hero.style.transform =
            `translateY(${window.scrollY * 0.18}px)`;
    }

});

</script>

</body>
